{
  "name": "@oakreader/backend",
  "version": "0.2.0",
  "private": true,
  "description": "OakReader AI sidecar: JSONL-over-stdio protocol on top of pi-ai. See docs/architecture/node-backend-migration.md.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/oak-backend.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/protocol.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
