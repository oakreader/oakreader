{
  "name": "@oakreader/backend",
  "version": "0.2.0",
  "private": true,
  "description": "OakReader AI sidecar: JSONL-over-stdio protocol on top of pi-ai. See docs/architecture/node-backend-migration.md.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "bash scripts/build-binary.sh",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/protocol.test.mjs && node --experimental-strip-types --test test/tokenizer.test.mjs",
    "build:binary": "bash scripts/build-binary.sh",
    "build:binary:universal": "OAK_UNIVERSAL=1 bash scripts/build-binary.sh",
    "build:binary:win": "OAK_TARGET=win bash scripts/build-binary.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "defuddle": "^0.18.1",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
